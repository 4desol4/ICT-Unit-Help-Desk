{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://ict-unit-help-desk.onrender.com/api/$1"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "https://ict-unit-help-desk.onrender.com/socket.io/$1"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
