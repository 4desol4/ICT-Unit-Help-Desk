{
  "version": 2,
  "env": {
    "VITE_API_BASE": "https://ict-unit-help-desk.onrender.com/api",
    "VITE_SOCKET_URL": "https://ict-unit-help-desk.onrender.com"
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": ".*\\.(png|jpg|jpeg|gif|webp|svg|ico|css|js|woff|woff2)$",
      "dest": "/$0"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
