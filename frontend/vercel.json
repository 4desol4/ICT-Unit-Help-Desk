{
  "version": 2,
  "builds": [{ "src": "package.json", "use": "@vercel/static-build" }],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://ict-unit-help-desk.onrender.com/$1"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "https://ict-unit-help-desk.onrender.com/socket.io/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": ".*\\.(png|jpg|jpeg|gif|webp|svg|ico|css|js|woff|woff2)$",
      "dest": "/$0"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
