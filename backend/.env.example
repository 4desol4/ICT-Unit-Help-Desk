# Backend environment settings for local dev and production
PORT=5000

# DATABASE_URL - Development Database (Required for dev)
# Use your local PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/ict_support_db

# NEON_DATABASE_URL - Production Database (Required for production)
# Use your Neon cloud database connection string
# Get from: Neon Dashboard → Project → Connection → Connection String
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
JWT_SECRET=supersecretkey
CLIENT_URLS=http://localhost:5173,http://ict.unit

# Firebase service account settings
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json


# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CLIENT_URL=https://your-frontend.vercel.app
