# Backend environment settings for local dev and production
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL_LOCAL=postgresql://user:password@localhost:5432/dbname
JWT_SECRET=supersecretkey
CLIENT_URLS=http://localhost:5173,http://ict.unit

# Firebase service account settings
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json


# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CLIENT_URL=https://your-frontend.vercel.app
